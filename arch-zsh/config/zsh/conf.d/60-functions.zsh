# ------------------------------------------------------------------------------
# mkcd DIR
# Создать каталог и сразу войти в него.
# ------------------------------------------------------------------------------

mkcd() {
    if (( $# != 1 )); then
        print -u2 "Использование: mkcd <директория>"
        return 2
    fi

    mkdir -p -- "$1" && cd -- "$1"
}


# ------------------------------------------------------------------------------
# croot
# Перейти в корень текущего Git-репозитория.
# ------------------------------------------------------------------------------

croot() {
    local root
    root=$(git rev-parse --show-toplevel 2>/dev/null) || {
        print -u2 "Текущая директория не находится внутри Git-репозитория."
        return 1
    }

    cd -- "$root"
}


# ------------------------------------------------------------------------------
# ff [QUERY]
# Интерактивно выбрать файл через fzf и открыть его в $EDITOR.
# ------------------------------------------------------------------------------

ff() {
    (( $+commands[fzf] )) || {
        print -u2 "ff: требуется пакет fzf"
        return 127
    }

    local selected
    selected=$(
        fzf \
            --query="${*:-}" \
            --walker=file,follow,hidden \
            --walker-skip=.git,node_modules,target,.venv \
            --preview='bat --color=always --style=numbers --line-range=:300 {} 2>/dev/null || sed -n "1,300p" {} 2>/dev/null'
    ) || return

    [[ -n "$selected" ]] && "${EDITOR:-nvim}" -- "$selected"
}


# ------------------------------------------------------------------------------
# fcd [QUERY]
# Интерактивно выбрать директорию через fzf и перейти в неё.
# ------------------------------------------------------------------------------

fcd() {
    (( $+commands[fzf] )) || {
        print -u2 "fcd: требуется пакет fzf"
        return 127
    }

    local selected
    selected=$(
        fzf \
            --query="${*:-}" \
            --walker=dir,follow,hidden \
            --walker-skip=.git,node_modules,target,.venv \
            --preview='eza -la --icons=auto --color=always {} 2>/dev/null || ls -la -- {}'
    ) || return

    [[ -n "$selected" ]] && cd -- "$selected"
}


# ------------------------------------------------------------------------------
# path
# Показать $PATH по одной директории на строку.
# ------------------------------------------------------------------------------

pathlist() {
    print -l -- $path
}
